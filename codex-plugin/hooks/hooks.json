    "PermissionRequest": [
      {
        "hooks": [
          {
            "command_windows": "curl.exe -s -m 65 --data-binary '@-' http://127.0.0.1:47616/ask; exit 0",
            "timeout": 75,
            "type": "command",
            "command": "curl -s -m 65 --data-binary '@-' http://127.0.0.1:47616/ask; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command_windows": "curl.exe -s -m 65 --data-binary '@-' http://127.0.0.1:47616/stop; exit 0",
            "timeout": 75,
