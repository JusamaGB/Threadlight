{
  "description": "Threadlight Codex lifecycle events and bounded question/approval holds. Closed or unavailable Threadlight returns control to Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command_windows": "curl.exe -s -m 1 --data-binary '@-' http://127.0.0.1:47616/hook/SessionStart; exit 0",
            "timeout": 3,
            "type": "command",
            "command": "curl -s -m 1 --data-binary '@-' http://127.0.0.1:47616/hook/SessionStart; exit 0"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command_windows": "curl.exe -s -m 1 --data-binary '@-' http://127.0.0.1:47616/hook/SessionEnd; exit 0",
            "timeout": 3,
            "type": "command",
            "command": "curl -s -m 1 --data-binary '@-' http://127.0.0.1:47616/hook/SessionEnd; exit 0"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command_windows": "curl.exe -s -m 1 --data-binary '@-' http://127.0.0.1:47616/hook/UserPromptSubmit; exit 0",
